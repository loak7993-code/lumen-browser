<?xml version="1.0" encoding="utf-8"?>
<!-- Extension popup bottom sheet: slides up from the bottom, modal.
     Header bar with the extension name + a close (X) button, then the WebView
     fills the rest. A drag handle sits at the very top. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg">

    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/sheet_handle_bg"
        android:alpha="0.4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <ImageView
            android:id="@+id/extPopupIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_addons"
            app:tint="?attr/colorPrimary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/extPopupTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/extPopupClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_find_close"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurface"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/extPopupWebContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
